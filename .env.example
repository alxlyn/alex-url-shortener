DATABASE_URL=postgresql://localhost/url_shortener
REDIS_URL=redis://localhost:6379
# Set to 1 to skip CREATE TABLE on startup (e.g. in tests or when schema is pre-applied)
# SKIP_DB_INIT=0

# Base URL used in the short links the app hands out
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Proxies in front of the app that append to X-Forwarded-For (0 = none, Cloud Run = 1)
TRUSTED_PROXY_HOPS=0
